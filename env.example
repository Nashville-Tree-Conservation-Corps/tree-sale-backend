# Copy to .env.local (gitignored); server.js loads .env.local then .env.
GOOGLE_CLOUD_PROJECT=tree-sale
# Comma-separated browser origins allowed to call this API.
FRONTEND_ORIGIN=http://localhost:5173
PORT=3000
SQUARESPACE_API_KEY=
# Local only: path to a Firebase Admin SDK service account key so the
# backend does not depend on gcloud user ADC. Unset in Cloud Functions.
GOOGLE_APPLICATION_CREDENTIALS=./tree-sale-firebase-adminsdk-<id>.json
